PORT=5000
JWT_SECRET=your-secure-secret-key-here-change-this
NODE_ENV=production

# ── Twilio (WhatsApp + SMS on complaint registration) ──────────────
# Get these from https://console.twilio.com/ once you log in.
# Leave any of them blank to disable that channel — the complaint will
# still save, just no message will go out.

# Twilio Account SID (starts with "AC…") — Console → Account → API keys & tokens
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio Auth Token — Console → Account → API keys & tokens (click "view" to reveal)
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here

# WhatsApp sender number in E.164 format, WITHOUT the "whatsapp:" prefix
# (the notify service adds the prefix automatically).
# Sandbox sender for testing is +14155238886 — Console → Messaging → Try it out → Send a WhatsApp message
# In production this becomes the WhatsApp Business sender we provision.
TWILIO_WHATSAPP_FROM=+14155238886

# SMS sender number in E.164 format. Console → Phone Numbers → Manage → Active numbers
# Indian DLT-registered sender ID can also be used here.
TWILIO_SMS_FROM=+12345678901

# ── File storage driver (uploads) ──────────────────────────────────
# Where uploaded FILES live. Databases are ALWAYS local regardless of this
# setting — SQLite needs real file locks and random writes.
#
# "local" (default) = data/uploads/, exactly as the app has always worked.
# Leave every S3_* var below blank while this is "local"; the AWS SDK is not
# even loaded in that mode.
STORAGE_DRIVER=local

# Set STORAGE_DRIVER=s3 and fill these in to serve uploads from a bucket.
# Works with any S3-compatible store (Cloudflare R2, MinIO, AWS S3).
# FIRST run:  npm i @aws-sdk/client-s3 @aws-sdk/s3-request-presigner
# The SDK is intentionally NOT a default dependency, so a local-driver install
# stays light. The server tells you this if you forget.
# (s3-request-presigner is only needed for offsite backup downloads, below.)
# R2 endpoint looks like https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
# Cloudflare R2 wants the literal value "auto"; AWS wants a real region.
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Prefix every object with this, e.g. "tenant_sepl/". THE single decoupling
# point for a future multi-tenant split — one org per prefix.
S3_KEY_PREFIX=

# Optional: public base URL of the bucket/CDN. When set, /uploads/* redirects
# here instead of the server proxying the bytes. Only use with a PUBLIC bucket.
S3_PUBLIC_BASE_URL=

# Push the nightly backup zip offsite. DELIBERATELY separate from
# STORAGE_DRIVER, so offsite DR can be switched on while uploads stay local.
BACKUP_S3=false
