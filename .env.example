PORT=5000
JWT_SECRET=your-secure-secret-key-here-change-this
NODE_ENV=production

# ── Redis optimization layer ───────────────────────────────────────
# Redis is OPTIONAL. If it's unreachable (or ERP_DISABLE_REDIS=1), the app
# degrades gracefully to its direct-SQLite behavior — nothing breaks, it's
# just not accelerated. Install locally with `apt install redis-server`
# (VPS) or WSL2/Docker (Windows dev); all reachable at localhost:6379.

# Connection URL — the ONLY place the Redis host is configured. Point this at a
# dedicated Redis node later (managed/private) with no code change.
REDIS_URL=redis://127.0.0.1:6379

# Namespace prefix for every key (keeps this app's keys distinct on a shared Redis).
REDIS_KEY_PREFIX=sepl

# Call presence heartbeat TTL, seconds (Workstream 4). Default 30s.
PRESENCE_TTL_SEC=30

# Kill-switches — set any to 1 to revert that layer to pre-Redis behavior in
# production WITHOUT a redeploy. ERP_DISABLE_REDIS forces full fallback.
ERP_DISABLE_REDIS=
ERP_DISABLE_JOB_QUEUE=

# The API embeds the BullMQ worker in-process by default (single `erp` process
# drains the queues). Set to 0 ONLY for PM2 cluster mode: run server/worker.js as
# a separate app and stop the N API instances from each embedding their own.
ERP_EMBED_WORKER=1

# ── Twilio (WhatsApp + SMS on complaint registration) ──────────────
# Get these from https://console.twilio.com/ once you log in.
# Leave any of them blank to disable that channel — the complaint will
# still save, just no message will go out.

# Twilio Account SID (starts with "AC…") — Console → Account → API keys & tokens
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio Auth Token — Console → Account → API keys & tokens (click "view" to reveal)
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here

# WhatsApp sender number in E.164 format, WITHOUT the "whatsapp:" prefix
# (the notify service adds the prefix automatically).
# Sandbox sender for testing is +14155238886 — Console → Messaging → Try it out → Send a WhatsApp message
# In production this becomes the WhatsApp Business sender we provision.
TWILIO_WHATSAPP_FROM=+14155238886

# SMS sender number in E.164 format. Console → Phone Numbers → Manage → Active numbers
# Indian DLT-registered sender ID can also be used here.
TWILIO_SMS_FROM=+12345678901
