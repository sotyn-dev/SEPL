# Platform control plane — copy to platform/.env and adjust.
# First-boot seed only applies when platform_users is empty.
# After that, change passwords via Operators → Set password.

# API
PLATFORM_PORT=7100
# PLATFORM_DATA_DIR=
# PLATFORM_DB_PATH=

# Bootstrap admin (first boot only)
PLATFORM_ADMIN_USER=admin
PLATFORM_ADMIN_PASSWORD=sotyn-dev
PLATFORM_ADMIN_EMAIL=sotyn.soft@gmail.com

# JWT (separate from ERP JWT_SECRET). Change in production.
PLATFORM_JWT_SECRET=platform-secret-change-in-production
# PLATFORM_JWT_DAYS=7

# Public UI origin for invite / reset links (no trailing slash).
# Production: https://platform.sotyn.com (Cloudflare Access gates the host — see docs/PLATFORM-Cloudflare-Access.md)
PLATFORM_PUBLIC_URL=http://127.0.0.1:7101
# PLATFORM_INVITE_DAYS=7
# PLATFORM_RESET_HOURS=24

# SMTP — invite / admin-reset / forgot-password email
# Same idea as ERP server/lib/email.js (nodemailer). Leave blank / commented to skip mail.
PLATFORM_SMTP_HOST=smtp.gmail.com
PLATFORM_SMTP_PORT=587
PLATFORM_SMTP_SECURE=0
PLATFORM_SMTP_USER=sotyn.soft@gmail.com
PLATFORM_SMTP_PASS=your-app-password
PLATFORM_EMAIL_FROM=Sotyn Platform <sotyn.soft@gmail.com>

# platform.db zip backups (local: platform/backups · VPS default: /var/lib/sotyn/platform-backups)
# PLATFORM_BACKUP_DIR=
# PLATFORM_BACKUP_KEEP=30

# Audit (mirrors ERP; default on). Set PLATFORM_DISABLE_AUDIT=1 to opt out.
# PLATFORM_DISABLE_AUDIT=0
# PLATFORM_AUDIT_DEBUG=1

# Worker agent (default / host_local — also seed token for local host)
AGENT_URL=http://127.0.0.1:7200
AGENT_TOKEN=dev-agent-token
# Extra VPS agents: register under platform Hosts UI (per-host URL + token)
