# Platform control plane — copy to platform/.env and adjust.
# First-boot seed only applies when platform_users is empty.
# After that, change passwords via Operators → Set password.

# API
PLATFORM_PORT=7100
# PLATFORM_DATA_DIR=
# PLATFORM_DB_PATH=

# Bootstrap admin (first boot only)
PLATFORM_ADMIN_USER=admin
PLATFORM_ADMIN_PASSWORD=sotyn-dev

# JWT (separate from ERP JWT_SECRET). Change in production.
PLATFORM_JWT_SECRET=platform-secret-change-in-production
# PLATFORM_JWT_DAYS=7

# Public UI origin for invite / reset links (no trailing slash)
PLATFORM_PUBLIC_URL=http://127.0.0.1:7101
# PLATFORM_INVITE_DAYS=7
# PLATFORM_RESET_HOURS=24

# platform.db zip backups (local: platform/backups · VPS default: /var/lib/sotyn/platform-backups)
# PLATFORM_BACKUP_DIR=
# PLATFORM_BACKUP_KEEP=30

# Worker agent (platform → agent)
AGENT_URL=http://127.0.0.1:7200
AGENT_TOKEN=dev-agent-token

# Optional: override secured tenant path recorded at seed
# SECURED_DATA_PATH=/root/erp/data
