# Worker agent env — copy to agent.env (gitignored) and edit.
# After changes: pm2 restart sotyn-agent
#
#   cp platform/agent.env.example platform/agent.env
#
# Day-1 (same VPS as platform): AGENT_TOKEN must match platform/.env
# Extra VPS: use a different AGENT_TOKEN; register it in platform Hosts UI.
# Full guide: Docs → Env (platform UI) · docs/PLATFORM-VPS-deploy.md

AGENT_TOKEN=dev-agent-token
HOST_ID=host_local
TENANTS_ROOT=/var/lib/sotyn/tenants
ERP_ENV_FILE=/root/erp/.env

# One-shot cutover only (sepl / orphan). Leave commented for normal use.
# After success: comment LEGACY_IMPORT_SLUG again and restart agent.
# LEGACY_IMPORT_SLUG=sepl
# LEGACY_DATA_DIR=/root/erp/data
# LEGACY_BACKUP_DIR=/root/erp-backups
