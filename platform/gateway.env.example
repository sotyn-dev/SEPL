# Gateway agent env — copy to gateway.env (gitignored) and edit.
#   cp platform/gateway.env.example platform/gateway.env
#
# Primary only (public :443). Platform UI: Docs → Gateway.

GATEWAY_TOKEN=dev-gateway-token
# GATEWAY_BIND=0.0.0.0
# GATEWAY_PORT=7300

# Conf + ACME webroot (compose mounts these)
# GATEWAY_SOTYN_DIR=/etc/nginx/sotyn.d
# GATEWAY_WEBROOT=/var/www/certbot
# GATEWAY_STATE_FILE=/var/lib/sotyn/gateway/routes.json
# GATEWAY_CERT_LIVE_ROOT=/etc/letsencrypt/live

# Let's Encrypt contact (required for real HTTP-01)
GATEWAY_CERTBOT_EMAIL=ops@sotyn.ai

# Compose sidecar reload (docker.sock on gateway service)
GATEWAY_NGINX_CONTAINER=sotyn-gateway-nginx

# Local / CI without certbot+nginx:
# GATEWAY_DRY_RUN=1

# Together on old VPS (host nginx) — leave NGINX_CONTAINER empty; set:
# GATEWAY_NGINX_TEST_CMD=nginx -t
# GATEWAY_NGINX_RELOAD_CMD=nginx -s reload
